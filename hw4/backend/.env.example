# Copy this file to backend/.env and fill in your own values. Never commit the real .env.

# --- AI model (required for the chatbot) ---
# API key for the Portkey gateway used by the course.
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
OPENAI_MODEL=gpt-6-luna

# --- Login sessions (optional) ---
# Secret used to sign login sessions. If left empty, one is generated in backend/.session_secret.
CC_SESSION_SECRET=

# --- Password-reset emails (optional) ---
# Address used in reset links.
SITE_URL=http://localhost:5175
# Leave SMTP_HOST empty in development: reset emails are then saved to backend/outbox/ instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Campus Customs <no-reply@example.com>
